# =============================================================================
# WeaponDetection — Inference Image
# CUDA 12.4.1 · cuDNN 9 runtime · Python 3.10 · Ubuntu 22.04
#
# Lighter than the training image (no devel headers, no TensorRT build tools).
# For TRT INT8 inference (--trt flag) you can either:
#   a) Use Dockerfile.train instead, or
#   b) Uncomment the TensorRT install block below.
#
# Build:
#   docker build -f Dockerfile.infer -t weapon-detection:infer .
#
# Webcam:
#   docker compose run --rm infer --source 0
#
# Video file (weights mounted via compose volume):
#   docker compose run --rm infer --source /data/test.mp4
# =============================================================================
ARG CUDA_VERSION=12.4.1
ARG CUDNN_VERSION=9

FROM nvidia/cuda:${CUDA_VERSION}-cudnn${CUDNN_VERSION}-runtime-ubuntu22.04

# ── Environment ──────────────────────────────────────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONHASHSEED=42

# ── System packages ───────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.10 \
        python3.10-dev \
        python3-pip \
        libgl1-mesa-glx \
        libglib2.0-0 \
        libsm6 \
        libxrender1 \
        libxext6 \
        libgomp1 \
        ffmpeg \
        v4l-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 \
 && update-alternatives --install /usr/bin/python  python  /usr/bin/python3.10 1 \
 && python -m pip install --upgrade pip

# ── PyTorch (CUDA 12.4) ───────────────────────────────────────────────────────
RUN pip install --no-cache-dir \
        torch==2.6.0+cu124 \
        torchvision==0.21.0+cu124 \
        --index-url https://download.pytorch.org/whl/cu124

# Uncomment to enable --trt (TensorRT INT8) inference:
# RUN pip install --no-cache-dir tensorrt==10.15.1.29 \
#         --extra-index-url https://pypi.nvidia.com

# ── Project dependencies ──────────────────────────────────────────────────────
COPY docker/requirements_infer.txt /tmp/requirements_infer.txt
RUN pip install --no-cache-dir -r /tmp/requirements_infer.txt

# ── Project code ──────────────────────────────────────────────────────────────
WORKDIR /workspace
COPY . /workspace/

RUN mkdir -p logs/alerts

ENTRYPOINT ["python", "inference.py"]
CMD ["--source", "0", "--config", "config/hyperparams.yaml"]
