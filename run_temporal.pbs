#!/bin/bash
# run_temporal.pbs — Step 4: BiLSTM Temporal Smoother
#
# Submit from ~/Weapon_detection on the HPC:
#   qsub run_temporal.pbs
#
# Requires: logs/detector/best.pt (from run_detector.pbs)
# Estimated walltime: ~2h on L40 (30 epochs, small BiLSTM, short sequences)
# Output weights: logs/temporal/best.pt

#PBS -N weapon_temporal
#PBS -l select=1:ncpus=4:ngpus=1:mem=16gb
#PBS -l walltime=4:00:00
#PBS -l place=shared
#PBS -q gpu
#PBS -m abe
#PBS -o logs/pbs_temporal.out
#PBS -e logs/pbs_temporal.err

cd $PBS_O_WORKDIR
mkdir -p logs logs/temporal

source /apps/anaconda3/bin/activate deeplearning
export TORCH_HOME=$PBS_O_WORKDIR/.cache/torch

# ── Job banner ────────────────────────────────────────────────────────────────
echo "════════════════════════════════════════════════════"
echo "  PBS Job ID   : $PBS_JOBID"
echo "  Node         : $(hostname)"
echo "  Working dir  : $PBS_O_WORKDIR"
echo "  Started      : $(date)"
echo "════════════════════════════════════════════════════"
nvidia-smi

# ── Pre-flight ────────────────────────────────────────────────────────────────
python -c "
import torch
print('torch', torch.__version__)
print('cuda ', torch.cuda.is_available())
print('gpu  ', torch.cuda.get_device_name(0))
"

if ! python -c "import ultralytics" 2>/dev/null; then
    echo "ERROR: ultralytics not installed. On LOGIN NODE run:"
    echo "  source /apps/anaconda3/bin/activate deeplearning"
    echo "  pip install --user -r $PBS_O_WORKDIR/requirements_hpc.txt"
    exit 1
fi

for f in train_all.py config/hyperparams.yaml \
          src/functions/temporal.py \
          logs/detector/best.pt \
          data/sequences; do
    [ -e "$f" ] || { echo "ERROR: missing $f"; exit 1; }
done

SEQ_COUNT=$(find data/sequences -name "*.mp4" -o -name "*.avi" 2>/dev/null | wc -l)
echo "  ✓ Pre-flight passed  (sequences: $SEQ_COUNT video files)"

EPOCHS=$(python -c "import yaml; c=yaml.safe_load(open('config/hyperparams.yaml')); print(c['temporal']['epochs'])")
echo "  Config: ${EPOCHS} epochs"

# ── Train ─────────────────────────────────────────────────────────────────────
ulimit -n 65536 2>/dev/null || true
export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0}

echo ""
echo "── Step 4: Temporal smoother training ─────────────────────"
python -u train_all.py --only 4
EXIT_CODE=$?

echo ""
echo "════════════════════════════════════════════════════"
echo "  Finished   : $(date)"
echo "  Exit code  : $EXIT_CODE"
[ -f logs/temporal/best.pt ] && echo "  Output     : logs/temporal/best.pt ($(du -sh logs/temporal/best.pt | cut -f1))"
echo "════════════════════════════════════════════════════"
exit $EXIT_CODE
