#!/bin/bash
# run_detector.pbs — Step 2: Train YOLOv8s detector (640px)
#
# Submit from ~/Weapon_detection on the HPC:
#   qsub run_detector.pbs
#
# Estimated walltime: ~10h on L40 (100 epochs, bs=32, 640px, 49K images)
# Output weights: logs/detector/best.pt

#PBS -N weapon_detector
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -l walltime=16:00:00
#PBS -l place=shared
#PBS -q gpu
#PBS -m abe
#PBS -o logs/pbs_detector.out
#PBS -e logs/pbs_detector.err

cd $PBS_O_WORKDIR
mkdir -p logs logs/detector

source /apps/anaconda3/bin/activate deeplearning
export TORCH_HOME=$PBS_O_WORKDIR/.cache/torch

# ── Job banner ────────────────────────────────────────────────────────────────
echo "════════════════════════════════════════════════════"
echo "  PBS Job ID   : $PBS_JOBID"
echo "  Node         : $(hostname)"
echo "  Working dir  : $PBS_O_WORKDIR"
echo "  Started      : $(date)"
echo "════════════════════════════════════════════════════"
nvidia-smi

# ── Pre-flight ────────────────────────────────────────────────────────────────
python -c "
import torch
print('torch', torch.__version__)
print('cuda ', torch.cuda.is_available())
print('gpu  ', torch.cuda.get_device_name(0))
"

if ! python -c "import ultralytics" 2>/dev/null; then
    echo "ERROR: ultralytics not installed. On LOGIN NODE run:"
    echo "  source /apps/anaconda3/bin/activate deeplearning"
    echo "  pip install --user -r $PBS_O_WORKDIR/requirements_hpc.txt"
    exit 1
fi

for f in train_all.py config/hyperparams.yaml \
          src/model.py src/functions/detector.py \
          data/dataset.yaml data/images/train data/labels/train; do
    [ -e "$f" ] || { echo "ERROR: missing $f"; exit 1; }
done
echo "  ✓ Pre-flight passed"

EPOCHS=$(python -c "import yaml; c=yaml.safe_load(open('config/hyperparams.yaml')); print(c['detector']['epochs'])")
IMG=$(python   -c "import yaml; c=yaml.safe_load(open('config/hyperparams.yaml')); print(c['detector']['img_size'])")
BS=$(python    -c "import yaml; c=yaml.safe_load(open('config/hyperparams.yaml')); print(c['detector']['batch_size'])")
echo "  Config: ${EPOCHS} epochs  img=${IMG}  bs=${BS}"

# ── Train ─────────────────────────────────────────────────────────────────────
ulimit -n 65536 2>/dev/null || true
export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0}

echo ""
echo "── Step 2: Detector training ───────────────────────────────"
python -u train_all.py --only 2
EXIT_CODE=$?

echo ""
echo "════════════════════════════════════════════════════"
echo "  Finished   : $(date)"
echo "  Exit code  : $EXIT_CODE"
[ -f logs/detector/best.pt ] && echo "  Output     : logs/detector/best.pt ($(du -sh logs/detector/best.pt | cut -f1))"
echo "════════════════════════════════════════════════════"
exit $EXIT_CODE
