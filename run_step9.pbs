#!/bin/bash
# run_step9.pbs — PBS submission script for step 9 (multi-teacher KD distillation)
#
# Submit from the Weapon_detection directory on the HPC:
#   cd ~/Weapon_detection
#   qsub run_step9.pbs
#
# One-time setup on a LOGIN NODE before first submission:
#   source /apps/anaconda3/bin/activate deeplearning
#   pip install --user --no-deps --trusted-host pypi.org --trusted-host files.pythonhosted.org -r requirements_hpc.txt
# (compute nodes usually have no outbound internet, so deps must be pre-installed)

#PBS -N weapon_step9
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -l walltime=24:00:00
#PBS -l place=shared
#PBS -q gpu
#PBS -m abe
#PBS -o logs/pbs_step9.out
#PBS -e logs/pbs_step9.err

# ═════════════════════════════════════════════════════════════════════
#  CUDA toolkit — torch 2.4.1+cu121 bundles its own CUDA runtime,
#  and the NVIDIA driver (555.42.02) is already active on the node,
#  so no `module load` is required. If your cluster admin asks you
#  to load a cuda module, add it here (e.g. `module load cuda/12.1`).
# ═════════════════════════════════════════════════════════════════════

# ═════════════════════════════════════════════════════════════════════
#  Change to submission directory (expects qsub from Weapon_detection/)
# ═════════════════════════════════════════════════════════════════════
cd $PBS_O_WORKDIR
mkdir -p logs

# ═════════════════════════════════════════════════════════════════════
#  Activate shared conda env (pre-existing on the cluster)
# ═════════════════════════════════════════════════════════════════════
source /apps/anaconda3/bin/activate deeplearning

# ═════════════════════════════════════════════════════════════════════
#  Job banner + GPU info
# ═════════════════════════════════════════════════════════════════════
echo "════════════════════════════════════════════════════"
echo "  PBS Job ID   : $PBS_JOBID"
echo "  Node         : $(hostname)"
echo "  Working dir  : $PBS_O_WORKDIR"
echo "  CUDA visible : $CUDA_VISIBLE_DEVICES"
echo "  Started      : $(date)"
echo "════════════════════════════════════════════════════"
nvidia-smi

# ═════════════════════════════════════════════════════════════════════
#  Pre-flight: Python, CUDA, Ultralytics
# ═════════════════════════════════════════════════════════════════════
python -c "import torch; print('torch', torch.__version__); print('cuda_available', torch.cuda.is_available()); print('gpu', torch.cuda.get_device_name(0))"

if ! python -c "import ultralytics; print('ultralytics', ultralytics.__version__)" 2>/dev/null; then
    echo ""
    echo "ERROR: ultralytics not installed in the 'deeplearning' env."
    echo "Run ONCE on a LOGIN NODE (not a compute node):"
    echo "    source /apps/anaconda3/bin/activate deeplearning"
    echo "    pip install --user --no-deps --trusted-host pypi.org --trusted-host files.pythonhosted.org -r $PBS_O_WORKDIR/requirements_hpc.txt"
    echo "Then re-submit:  qsub run_step9.pbs"
    exit 1
fi

# ═════════════════════════════════════════════════════════════════════
#  Verify required inputs exist
# ═════════════════════════════════════════════════════════════════════
for f in train_all.py yolo11n.pt \
         config/hyperparams.yaml \
         src/functions/distill.py \
         runs/detect/logs/fp_correction/weights/best.pt \
         data/dataset.yaml \
         data/images/train data/images/val \
         data/labels/train data/labels/val ; do
    if [ ! -e "$f" ]; then
        echo "ERROR: missing required input: $f"
        exit 1
    fi
done
echo "  ✓ All required inputs present"

# ═════════════════════════════════════════════════════════════════════
#  Run step 9 — multi-teacher KD → YOLO11n student distillation
# ═════════════════════════════════════════════════════════════════════
echo ""
echo "── Launching train_all.py --only 9 ───────────────────"
# Raise open-file-descriptor limit — high batch_size + multiple dataloader
# workers exhaust the default fd limit via shared-memory tensor passing.
ulimit -n 65536 2>/dev/null || true

# PBS sets CUDA_VISIBLE_DEVICES to the allocated GPU when ngpus=1 is requested.
# Fall back to device 0 if PBS did not set it.
export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0}

python -u train_all.py --only 9
EXIT_CODE=$?

echo ""
echo "════════════════════════════════════════════════════"
echo "  Finished   : $(date)"
echo "  Exit code  : $EXIT_CODE"
echo "════════════════════════════════════════════════════"

exit $EXIT_CODE
