#!/bin/bash
# run_part4.pbs — PBS submission script for Part 4 (FP correction with drone negatives)
#
# Submit from the Weapon_detection directory on the HPC:
#   cd ~/Weapon_detection
#   qsub run_part4.pbs
#
# One-time setup on LOGIN NODE before first submission:
#   source /apps/anaconda3/bin/activate deeplearning
#   pip install --user -r requirements_hpc.txt

#PBS -N weapon_fp_corr
#PBS -l select=1:ncpus=8:ngpus=1:mem=48gb
#PBS -l walltime=12:00:00
#PBS -l place=shared
#PBS -q gpu
#PBS -m abe
#PBS -o logs/pbs_part4.out
#PBS -e logs/pbs_part4.err

cd $PBS_O_WORKDIR
mkdir -p logs logs/fp_correction

# ═════════════════════════════════════════════════════════════════════
#  Activate shared conda env
# ═════════════════════════════════════════════════════════════════════
source /apps/anaconda3/bin/activate deeplearning

# Point torch hub cache to project dir
export TORCH_HOME=$PBS_O_WORKDIR/.cache/torch

# ═════════════════════════════════════════════════════════════════════
#  Job banner + GPU info
# ═════════════════════════════════════════════════════════════════════
echo "════════════════════════════════════════════════════"
echo "  PBS Job ID   : $PBS_JOBID"
echo "  Node         : $(hostname)"
echo "  Working dir  : $PBS_O_WORKDIR"
echo "  CUDA visible : $CUDA_VISIBLE_DEVICES"
echo "  Started      : $(date)"
echo "════════════════════════════════════════════════════"
nvidia-smi

# ═════════════════════════════════════════════════════════════════════
#  Pre-flight: Python + CUDA + Ultralytics
# ═════════════════════════════════════════════════════════════════════
python -c "
import torch, torchvision
print('torch      ', torch.__version__)
print('torchvision', torchvision.__version__)
print('cuda       ', torch.cuda.is_available())
print('gpu        ', torch.cuda.get_device_name(0))
"

if ! python -c "import ultralytics; print('ultralytics', ultralytics.__version__)" 2>/dev/null; then
    echo ""
    echo "ERROR: ultralytics not installed in the 'deeplearning' env."
    echo "Run ONCE on a LOGIN NODE:"
    echo "    source /apps/anaconda3/bin/activate deeplearning"
    echo "    pip install --user -r $PBS_O_WORKDIR/requirements_hpc.txt"
    exit 1
fi

# ═════════════════════════════════════════════════════════════════════
#  Verify required inputs
# ═════════════════════════════════════════════════════════════════════
for f in part4.py \
         config/hyperparams.yaml \
         src/model.py src/functions/common.py \
         src/functions/fp_correction.py \
         logs/detector/best.pt \
         logs/classifier/best.pt \
         data/negatives/visdrone \
         data/dataset.yaml \
         data/images/train data/images/val \
         data/labels/train data/labels/val; do
    if [ ! -e "$f" ]; then
        echo "ERROR: missing required input: $f"
        exit 1
    fi
done
echo "  ✓ All required inputs present"

# Count negatives
NEG_COUNT=$(ls data/negatives/visdrone/*.jpg 2>/dev/null | wc -l)
echo "  VisDrone negatives : $NEG_COUNT images"

# ═════════════════════════════════════════════════════════════════════
#  Run Part 4 — FP Correction (mine + threshold sweep + fine-tune)
# ═════════════════════════════════════════════════════════════════════
echo ""
echo "── Launching part4.py ──────────────────────────────────"
ulimit -n 65536 2>/dev/null || true
export CUDA_VISIBLE_DEVICES=1

python -u part4.py \
    --config   config/hyperparams.yaml \
    --skip-mining \
    --skip-sweep \
    --det-ckpt runs/detect/logs/fp_correction/weights/best.pt \
    --cls-ckpt logs/classifier/best.pt
EXIT_CODE=$?

echo ""
echo "════════════════════════════════════════════════════"
echo "  Finished   : $(date)"
echo "  Exit code  : $EXIT_CODE"
if [ -f logs/fp_correction/detector_ft_best.pt ]; then
    echo "  FT Detector  : logs/fp_correction/detector_ft_best.pt"
fi
if [ -f logs/fp_correction/classifier_bg_best.pt ]; then
    echo "  FT Classifier: logs/fp_correction/classifier_bg_best.pt"
fi
if [ -f runs/detect/logs/fp_correction/weights/best.pt ]; then
    echo "  YOLO FT Det  : runs/detect/logs/fp_correction/weights/best.pt"
fi
echo "════════════════════════════════════════════════════"

exit $EXIT_CODE
