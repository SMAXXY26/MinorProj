#!/bin/bash
# run_all.pbs — Full pipeline: detector → classifier → temporal → FP correction → distillation
#
# Runs steps 0,1,2,3,4,5,9 in a single GPU job.  Steps 6-8 (eval/export/test)
# are skipped — run them locally after pulling weights back.
#
# Submit from ~/Weapon_detection:
#   qsub run_all.pbs
#
# Expected walltime on L40 (46 GB VRAM):
#   Step 2 — YOLOv8s detector  100 ep  bs=32  640px  → ~10h
#   Step 3 — EfficientNet-B5   200 ep  bs=32  224px  → ~4h
#   Step 4 — BiLSTM temporal    30 ep  bs=32         → ~1h
#   Step 5 — FP correction     fine-tune              → ~5h
#   Step 9 — YOLO11n-P2 KD    200 ep  bs=128 416px  → ~14h
#   ─────────────────────────────────────────────────────────
#   Total estimated                                  → ~34h
#
# Outputs:
#   logs/detector/best.pt                 — YOLOv8s detector
#   logs/classifier/best.pt               — EfficientNet-B5 classifier
#   logs/temporal/best.pt                 — BiLSTM temporal smoother
#   logs/fp_correction/detector_ft_best.pt— FP-corrected detector (teacher)
#   logs/student/best.pt                  — YOLO11n-P2 student (edge model)

#PBS -N weapon_full_pipeline
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=48:00:00
#PBS -l place=shared
#PBS -q gpu
#PBS -m abe
#PBS -o logs/pbs_all.out
#PBS -e logs/pbs_all.err

cd $PBS_O_WORKDIR
mkdir -p logs logs/detector logs/classifier logs/temporal \
         logs/fp_correction logs/student \
         runs/detect/logs/fp_correction/weights \
         .cache/torch/hub/checkpoints

source /apps/anaconda3/bin/activate deeplearning
export TORCH_HOME=$PBS_O_WORKDIR/.cache/torch

# ── Job banner ────────────────────────────────────────────────────────────────
echo "════════════════════════════════════════════════════════════════"
echo "  PBS Job ID   : $PBS_JOBID"
echo "  Node         : $(hostname)"
echo "  Working dir  : $PBS_O_WORKDIR"
echo "  CUDA visible : ${CUDA_VISIBLE_DEVICES:-auto}"
echo "  Started      : $(date)"
echo "  Steps        : 0 1 2 3 4 5 9"
echo "════════════════════════════════════════════════════════════════"
nvidia-smi

# ── Environment check ────────────────────────────────────────────────────────
python -c "
import torch, torchvision
print('torch      ', torch.__version__)
print('torchvision', torchvision.__version__)
print('cuda       ', torch.cuda.is_available())
print('gpu        ', torch.cuda.get_device_name(0))
print('vram_gb    ', round(torch.cuda.get_device_properties(0).total_memory / 1e9, 1))
"

if ! python -c "import ultralytics; print('ultralytics', ultralytics.__version__)" 2>/dev/null; then
    echo ""
    echo "ERROR: ultralytics not installed."
    echo "On a LOGIN NODE (NOT this compute node) run once:"
    echo "  source /apps/anaconda3/bin/activate deeplearning"
    echo "  pip install --user -r $PBS_O_WORKDIR/requirements_hpc.txt"
    echo "Then re-submit: qsub run_all.pbs"
    exit 1
fi

# ── Pre-flight: all inputs for the full pipeline ─────────────────────────────
MISSING=0
for f in \
    train_all.py \
    config/hyperparams.yaml \
    config/yolo11n_p2.yaml \
    requirements_hpc.txt \
    yolo11n.pt \
    src/__init__.py \
    src/model.py \
    src/dataset.py \
    src/losses.py \
    src/augmentations.py \
    src/functions/__init__.py \
    src/functions/distill.py \
    src/functions/detector.py \
    src/functions/classifier.py \
    src/functions/temporal.py \
    src/functions/fp_correction.py \
    src/functions/small_object_aug.py \
    src/functions/monitor.py \
    data/dataset.yaml \
    data/images/train \
    data/images/val \
    data/labels/train \
    data/labels/val; do
    if [ ! -e "$f" ]; then
        echo "  MISSING: $f"
        MISSING=$((MISSING + 1))
    fi
done

# Warn on optional inputs (don't abort)
[ -f logs/student/best.pt ] && echo "  ✓ Previous student found — iterative KD warm-start will activate"
[ -d data/sequences ]       && SEQ_COUNT=$(find data/sequences -name "*.mp4" -o -name "*.avi" 2>/dev/null | wc -l) \
                            && echo "  ✓ Sequences found: $SEQ_COUNT video files (step 4)"
[ -d data/negatives/visdrone ] && echo "  ✓ VisDrone negatives found (step 5)"

if [ "$MISSING" -gt 0 ]; then
    echo ""
    echo "ERROR: $MISSING required file(s) missing. Re-run transfer_to_hpc.sh --full"
    exit 1
fi
echo "  ✓ All required inputs present"

# Print label stats
echo "  Train images : $(ls data/images/train | wc -l)"
echo "  Val   images : $(ls data/images/val   | wc -l)"

# ── GPU selection ─────────────────────────────────────────────────────────────
# PBS sets CUDA_VISIBLE_DEVICES when ngpus=1 is allocated; if not, default to 0.
ulimit -n 65536 2>/dev/null || true
export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0}
echo "  GPU device   : $CUDA_VISIBLE_DEVICES"

# ── Run full pipeline ─────────────────────────────────────────────────────────
echo ""
echo "── Launching full pipeline (steps 0 1 2 3 4 5 9) ──────────────"
echo "   Skipping steps 6,7,8 (eval/export/smoke-test — run locally)"
echo ""

python -u train_all.py --only 0 1 2 3 4 5 9
EXIT_CODE=$?

# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
echo "════════════════════════════════════════════════════════════════"
echo "  Pipeline finished  : $(date)"
echo "  Exit code          : $EXIT_CODE"
echo ""
echo "  Output weights:"
for f in \
    "logs/detector/best.pt                    (YOLOv8s teacher)" \
    "logs/classifier/best.pt                  (EfficientNet-B5)" \
    "logs/temporal/best.pt                    (BiLSTM smoother)" \
    "logs/fp_correction/detector_ft_best.pt   (FP-corrected teacher)" \
    "runs/detect/logs/fp_correction/weights/best.pt  (YOLO FP teacher)" \
    "logs/student/best.pt                     (YOLO11n-P2 student)"; do
    PATH_PART=$(echo "$f" | awk '{print $1}')
    DESC=$(echo "$f" | cut -d' ' -f2-)
    if [ -f "$PATH_PART" ]; then
        SZ=$(du -sh "$PATH_PART" | cut -f1)
        echo "    ✓ $SZ  $f"
    else
        echo "    ✗ missing  $f"
    fi
done
echo ""
echo "  To pull all weights back to your local machine:"
echo "    bash transfer_from_hpc.sh   (or scp individually)"
echo "════════════════════════════════════════════════════════════════"

exit $EXIT_CODE
