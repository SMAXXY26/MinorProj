# =============================================================================
# WeaponDetection — Singularity/Apptainer definition for Rachel HPC cluster
#
# Rachel GPU node: 2× NVIDIA L40 (46 GB VRAM, Ada Lovelace, driver 555.42.02)
# Cluster CUDA: 12.1 (via torch bundle — no `module load cuda` needed)
#
# Build (on Rachel login node or a machine with Apptainer ≥ 1.1):
#   apptainer build weapon_detection.sif Singularity.def
#
# Run via PBS (see run_step9.pbs):
#   apptainer exec --nv weapon_detection.sif \
#       python train_all.py --only 9 --config config/hyperparams.yaml
#
# Interactive shell:
#   apptainer shell --nv weapon_detection.sif
# =============================================================================
Bootstrap: docker
From: nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

%labels
    Author btech10170.23
    Description WeaponDetection — Step-9 student distillation (Rachel L40)
    CUDA 12.1 (matches driver 555.42.02 on rachel-gpu)

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONHASHSEED=42
    export CUBLAS_WORKSPACE_CONFIG=:4096:8
    # Prevent Ultralytics from writing to /root/.config inside the container
    export YOLO_CONFIG_DIR=/workspace/.ultralytics

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        git wget curl \
        libgl1-mesa-glx libglib2.0-0 libsm6 libxrender1 libxext6 \
        libgomp1 ffmpeg \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

    python3 -m pip install --upgrade pip

    # PyTorch matching Rachel's CUDA 12.1 environment
    # (cluster already has torch 2.4.1+cu121 in the deeplearning conda env,
    #  but this container is standalone so we install explicitly)
    pip install --no-cache-dir \
        torch==2.4.1+cu121 \
        torchvision==0.19.1+cu121 \
        --index-url https://download.pytorch.org/whl/cu121

    # Step-9 minimal deps (mirrors requirements_hpc.txt, pinned for reproducibility)
    pip install --no-cache-dir \
        ultralytics==8.4.21 \
        opencv-python-headless \
        PyYAML==6.0.2 \
        tqdm==4.67.1 \
        numpy==2.2.6 \
        scipy==1.15.3 \
        scikit-learn==1.7.2 \
        timm==1.0.25 \
        albumentations==2.0.8 \
        supervision==0.27.0.post2 \
        onnx==1.20.1 \
        requests==2.32.3

    mkdir -p /workspace

%runscript
    cd /workspace
    exec python3 train_all.py --only 9 "$@"

%help
    WeaponDetection student distillation container for Rachel HPC.

    Usage:
      apptainer run --nv weapon_detection.sif --config config/hyperparams.yaml
      apptainer exec --nv weapon_detection.sif python3 train_all.py --only 9
