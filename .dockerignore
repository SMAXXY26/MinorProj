# =============================================================================
# .dockerignore — keeps the build context lean by excluding large/generated
# directories.  Mount these as volumes at runtime instead.
# =============================================================================

# ── Dataset (mount via compose volume) ───────────────────────────────────────
data/images/
data/labels/
data/classifier_crops/
data/negatives/
data/sequences/

# ── Model outputs and checkpoints ─────────────────────────────────────────────
logs/
runs/
outputs/
weights/
models/

# ── Model weight binaries ──────────────────────────────────────────────────────
*.pt
*.pth
*.engine
*.onnx
*.trt
*.hef
*.wts

# ── Screenshots and media ──────────────────────────────────────────────────────
screenshots/
*.png
*.jpg
*.jpeg
*.mp4
*.avi
*.mov

# ── Python artifacts ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# ── Conda / venv ───────────────────────────────────────────────────────────────
miniforge3/
miniconda3/
anaconda3/
.conda/
venv/
env/
.venv/
.env

# ── Git ────────────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE ────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ─────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs / PBS output ──────────────────────────────────────────────────────────
*.log
*.jsonl
*.o[0-9]*
pbs_*.out
pbs_*.err

# ── Singularity build artifacts ────────────────────────────────────────────────
*.sif
*.simg
